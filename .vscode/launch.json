  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch file",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${file}",
      "env": {
        "APP_BASE_PATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Launch gogin 8081",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "cmd/gonic/main.go",
      "env": {
        "APP_BASE_PATH": "${workspaceFolder}",
        "PORT": "8081"
      }
    }
  ]
}
